# Kopieer dit bestand naar ".env" en vul je eigen waarden in.
# Het bestand ".env" staat in .gitignore en komt dus nooit op GitHub.

# Welke AI-provider? Kies uit: anthropic | openai | ollama | mock
# "mock" werkt zonder API-sleutel (vaste voorbeelduitvoer, handig voor testen en als terugvaloptie).
LLM_PROVIDER=mock

# Modelnaam. Laat leeg voor de standaard van de provider:
#   anthropic -> claude-opus-5-5
#   openai    -> gpt-4.1-mini
#   ollama    -> llama3.1
LLM_MODEL=

# Hoe diep het model nadenkt (alleen anthropic): low | medium | high
# "low" is snel en goedkoop, genoeg voor deze taak en prettig tijdens een live demo.
LLM_EFFORT=low

# API-sleutels (alleen invullen wat je gebruikt)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Alleen voor ollama (lokaal draaiend model)
OLLAMA_URL=http://localhost:11434
